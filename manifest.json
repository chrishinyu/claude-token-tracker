{
  "manifest_version": 3,
  "name": "Claude Token Tracker",
  "version": "0.5.2",
  "description": "Track your Claude AI usage like battery life. See quota utilization, per-model breakdowns, and when it resets.",
  "minimum_chrome_version": "109",
  "incognito": "not_allowed",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Claude Token Tracker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content-badge.js"],
      "run_at": "document_idle"
    }
  ]
}
